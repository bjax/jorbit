<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PlanetarySystem [
  <!ELEMENT PlanetarySystem (Body+)>
  <!ELEMENT Body (OrbitalRadius, Mass, Diameter, Color)>
  <!ATTLIST Body name   ID    #REQUIRED
                 MoonOf IDREF #IMPLIED>			<!-- MoonOf is just a hint about which body to circularize -->
  <!ELEMENT OrbitalRadius (#PCDATA)>
  <!ELEMENT Mass (#PCDATA)>
  <!ELEMENT Diameter (#PCDATA)>
  <!ELEMENT Color (#PCDATA)>
]>

<PlanetarySystem>
  <Body name="Sol"> 
